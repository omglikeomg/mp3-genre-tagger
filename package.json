{
  "name": "mp3-classifier",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-driven MP3 genre classification and tagging toolkit",
  "scripts": {
    "scan": "node scripts/prepare-input.js",
    "backfill": "node scripts/backfill-genres.js",
    "backfill:dry": "node scripts/backfill-genres.js --dry-run",
    "review": "node scripts/resolve-review.js",
    "review:list": "node scripts/resolve-review.js --list",
    "review:help": "node scripts/resolve-review.js --help",
    "verify-paths": "node scripts/verify-paths.js",
    "stats": "node scripts/review-stats.js --all",
    "stats:summary": "node scripts/review-stats.js --summary",
    "stats:genres": "node scripts/review-stats.js --genres",
    "stats:confidence": "node scripts/review-stats.js --confidence",
    "stats:manual": "node scripts/review-stats.js --manual",
    "stats:pairs": "node scripts/review-stats.js --pairs",
    "stats:low": "node scripts/review-stats.js --low-confidence",
    "snapshot": "node scripts/generate-snapshot.js",
    "scan:new": "node scripts/identify_new.js",
    "classify": "./classify.sh",
    "classify:new": "./classify.sh batches/new_music_batch_*.json",
    "recover": "node scripts/recover-artist-map.js",
    "recover:dry": "node scripts/recover-artist-map.js --dry-run",
    "merge-batch": "node scripts/merge-batch.js",
    "merge-batch:dry": "node scripts/merge-batch.js --dry-run",
    "thin-artists": "node scripts/thin-artists.js",
    "fix-genres": "node scripts/fix-genres.js --apply",
    "fix-genres:dry": "node scripts/fix-genres.js"
  },
  "dependencies": {
    "music-metadata": "*",
    "node-id3": "*"
  }
}
